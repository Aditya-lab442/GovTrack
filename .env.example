# GovTrack Civic Services Platform Environment Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Optional external MongoDB URI, otherwise file-backed embedded DB is used)
MONGO_URI=mongodb://localhost:27017/govtrack

# JWT Authentication
JWT_SECRET="govtrack-super-secure-production-jwt-key-2026"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="govtrack-refresh-token-secret-key-2026"

# App & Client URL
CLIENT_URL="http://localhost:3000"
APP_URL="MY_APP_URL"
UPLOAD_DIR="./uploads"

# Real Government Gateway Integration (Set live endpoints when connecting to state databases)
GOVERNMENT_API_BASE_URL="https://api.mock-gov-service.gov.in/v1"
GOVERNMENT_API_KEY="demo_gov_sandbox_key_2026"

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
