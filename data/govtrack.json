        {
          "name": "Passport Size Photograph",
          "description": "Recent front-facing color photo with white background.",
          "isRequired": true,
          "allowedFileTypes": [
            "jpg",
            "jpeg",
            "png"
          ],
          "maxFileSize": 2
        }
      ],
      "dynamicFormFields": [
