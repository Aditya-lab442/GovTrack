      "processingTime": 7,
      "fee": 50,
      "requiredDocuments": [
        {
          "name": "Aadhaar Card / Identity Proof",
          "description": "Clear front and back copy of government identity document.",
          "isRequired": true,
          "allowedFileTypes": [
            "pdf",
            "jpg",
            "jpeg",
            "png"
          ],
          "maxFileSize": 5
        },
        {
          "name": "Residential Address Proof",
          "description": "Electricity bill, water bill, or ration card matching current address.",
          "isRequired": true,
          "allowedFileTypes": [
            "pdf",
            "jpg",
            "jpeg",
            "png"
          ],
          "maxFileSize": 5
        },
        {
          "name": "Income Proof / Salary Slip / Affidavit",
